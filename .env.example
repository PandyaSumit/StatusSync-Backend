# =============================================================================
# BACKEND ONLY — set on Render (Environment) or local .env
# =============================================================================

NODE_ENV=production
# PORT is set automatically by Render — do not hardcode on Render

# Public URL of THIS backend service (no trailing slash)
APP_URL=https://statussync-backend.onrender.com

# Where the browser goes AFTER OAuth install (not your CDN URL)
FRONTEND_URL=https://monday.com

# monday Developer Center → OAuth & Permissions (copy values here)
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_SIGNING_SECRET=

# Must match EXACTLY what you enter in monday Developer Center → Redirect URL
MONDAY_REDIRECT_URI=https://statussync-backend.onrender.com/api/auth/monday/callback

MONDAY_OAUTH_SCOPES=boards:read,boards:write,account:read,users:read

# =============================================================================
# NOT USED BY FRONTEND — never put in VITE_* or frontend .env
# =============================================================================
# MONDAY_API_TOKEN=          # optional local dev only
# DATABASE_URL=              # later
# REDIS_URL=                 # later
# RESEND_API_KEY=            # later
