# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# monday.com app (Developer Center → OAuth & Permissions)
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_SIGNING_SECRET=
MONDAY_REDIRECT_URI=http://localhost:3000/api/auth/monday/callback

# OAuth scopes (comma-separated, must match Developer Center)
MONDAY_OAUTH_SCOPES=boards:read,boards:write,account:read,users:read

# Optional: personal API token for local GraphQL testing only (never use in production)
MONDAY_API_TOKEN=

# Database (PostgreSQL — wire Prisma/Drizzle when ready)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/statussync

# Redis (BullMQ scheduled digests — optional for MVP)
REDIS_URL=redis://localhost:6379

# Email (Resend or SendGrid)
RESEND_API_KEY=

# Session / encryption (generate: openssl rand -hex 32)
JWT_SECRET=
